PORT=4000
DATABASE_URL=postgres://postgres@localhost:5432/novamart
# Set to true for hosted Postgres that requires SSL (e.g. Neon, Supabase)
DATABASE_SSL=false
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Enables POST /api/test/reset (send header x-test-reset-key). Leave empty to disable.
TEST_RESET_KEY=
CORS_ORIGIN=*
